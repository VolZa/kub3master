        max-width: 520px;
        margin: 0 auto;
        padding: 16px;
        background: #ffffff;
        border-radius: 12px;
      }

      h2 {
        margin: 0 0 4px 0;
        font-size: 22px;
      }

      .subtitle {
        margin: 0 0 18px 0;
        color: #6b7280;
        font-size: 14px;
      }

      .field {
        margin-bottom: 14px;
      }

      label {
        display: block;
        margin-bottom: 5px;
        font-size: 14px;
        font-weight: 600;
      }

      input,
      textarea,
      select {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #ffffff;
