import { CatalogItem } from '../../../modules/catalog/catalog.model';
import { ICatalogRepository } from '../../../modules/catalog/catalog.repository.interface';
import { mapRowsToCatalogItems } from '../../../modules/catalog/catalog.mapper';
import { validateCatalogConsistency } from '../../../modules/catalog/ProductionRules';
import { getSheetByNameSafe } from '../../../utils/sheets';

export class CatalogInMemoryRepository implements ICatalogRepository {
  private byCode = new Map<string, CatalogItem>();

  constructor(rows: any[][]) {
    const items = mapRowsToCatalogItems(rows);

    items.forEach((item) => {
      validateCatalogConsistency(item);
      this.byCode.set(item.code, item);
    });
  }

  getByCode(code: string): CatalogItem | null {
    return this.byCode.get(code) || null;
  }

  requireByCode(code: string): CatalogItem {
    const item = this.getByCode(code);
    if (!item) {
      throw new Error(`❌ Catalog not found: ${code}`);
    }
    return item;
  }
}

export class GoogleSheetsCatalogRepository implements ICatalogRepository {
  private repo: CatalogInMemoryRepository;

  constructor() {
    const sheet = getSheetByNameSafe('04_Catalog');
    const data = sheet.getDataRange().getValues();

    // 🔥 передаємо rows в існуючий repo
    this.repo = new CatalogInMemoryRepository(data);
  }

  getByCode(code: string): CatalogItem | null {
    return this.repo.getByCode(code);
  }

  requireByCode(code: string): CatalogItem {
    return this.repo.requireByCode(code);
  }
}

