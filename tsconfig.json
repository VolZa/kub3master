{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "rootDir": "src",
    "types": ["node", "google-apps-script"],
    "esModuleInterop": true,
    "sourceMap": true,

    "paths": {
      "domain/*": ["./src/domain/*"],
      "technology/*": ["./src/technology/*"],
      "core/*": ["./src/core/*"],
      "shared/*": ["./src/shared/*"],
      "modules/*": ["./src/modules/*"],
      "utils/*": ["./src/utils/*"],
      "config/*": ["./src/config/*"],
      "services/*": ["./src/services/*"],
      "app/*": ["./src/app/*"],
      "infrastructure/*": ["./src/infrastructure/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["legacy", "dist", "node_modules"]
}
